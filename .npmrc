# Better Auth declares optional peers for every framework and driver it supports
# (pg, mysql2, @tanstack/react-start, …). npm tries to resolve them anyway and
# hits a Babel 7/8 conflict. None apply to this project — Azure SQL goes through
# kysely + tedious. Set here rather than passed as a flag so `npm ci` in the
# Docker build and the pipeline resolves exactly as it does locally.
legacy-peer-deps=true
