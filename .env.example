# Copy to .env.local for development. In Azure these are Container App secrets
# set by Bicep, not a file.

# Canonical origin — the single source of truth for the hostname. Everything
# needing an absolute URL reads from it: auth callbacks, cookie scope, metadata.
# Must be https in production; the app refuses to start otherwise.
APP_ORIGIN=https://www.onecrate.io

# openssl rand -base64 32
# Better Auth falls back to a DEFAULT secret if this is unset, which would make
# sessions forgeable. instrumentation.ts refuses to start without it.
BETTER_AUTH_SECRET=

# Auth tables. Same Azure SQL server as trade data, separate credentials.
AUTH_DB_SERVER=onecrate-sql.database.windows.net
AUTH_DB_NAME=onecrate-auth
AUTH_DB_USER=
# Quote this value if it contains a # — Node reads --env-file with dotenv
# rules, where an unquoted # begins a comment and silently empties the value.
AUTH_DB_PASSWORD=
AUTH_DB_PORT=1433

# Trade data. Read-only: this app never writes to a platform table.
#
# The SAME Azure SQL server as the auth database, but a different database on
# it, so it needs its own connection and its own pool. Note the database is
# named `trading-dev` even in production — the platform runs ONE database across
# both trading environments and separates them with the `environment` column
# (`live` for PROD, `paper` for DEV). That is not a misconfiguration.
#
# One connection string rather than discrete fields, deliberately: this is the
# same variable name the trading platform uses, so the value copies verbatim out
# of the shared Azure DevOps variable group with no second credential to rotate.
# src/lib/data/connection-string.ts parses it into the fields tedious wants.
#
# Quote the value if the password contains a # — Node reads --env-file with
# dotenv rules, where an unquoted # begins a comment.
TRADE_TRACKER_DB_CONNECTION_STRING=

# Deployment manifests (blob storage). The manifest is the source of truth for
# which executors exist and what capital each is allocated.
#
# Container `deployments`, blobs `deployed.dev.json` and `deployed.prod.json`.
# Both live in the SAME storage account, so one connection string covers both
# environments. Supplied by the `trading-prod-variables` group, which already
# defines this key for the platform's own pipelines.
STORAGE_CONNECTION_STRING=

# Optional per-environment overrides. Unset by default, because both manifests
# were verified to live in the same account. They exist because the dev and prod
# pipelines draw from separate Azure DevOps variable groups, so the accounts are
# free to diverge later — at which point this is configuration, not a code
# change. When set, the matching one wins over STORAGE_CONNECTION_STRING.
# STORAGE_CONNECTION_STRING_DEV=
# STORAGE_CONNECTION_STRING_PROD=
